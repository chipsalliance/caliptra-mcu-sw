`include "usbhsd.rdl"
`include "usb_hub.rdl"
`include "usb_ocp_recovery_reg.rdl"

// USB-local map presented by the Combo AXI subordinate port.
// Imported from chipsalliance/usb2 commit 53bdc64ba14d28848ea737a858f24043dff6fe46
// and flattened to that branch's Caliptra configuration.
addrmap usb_combo {
    name = "USB Combo AXI Port";
    desc = "USB-local map for the Combo AXI subordinate port. DEV0 control/status begins at 0x0000, the 2 KiB Recovery block is at 0x0800, and the rounded HUB aperture begins at 0x1000. Offsets outside these target windows are unmapped and return a bus error.";

    usbhsd dev0_csr @ 0x0000;

    // Recovery block: DEV0-only OCP Recovery aperture at Combo-local 0x0800..0x0FFF.
    // The recovery register block is generated separately from
    // usb_ocp_recovery_reg.rdl; this instance freezes the compound offset.
    usb_ocp_recovery_reg recovery @ 0x0800;

    usb_hub hub @ 0x1000;
};
