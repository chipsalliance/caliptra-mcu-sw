set_property PROBE_TYPE DATA_AND_TRIGGER [get_debug_ports usb_core_ila/probe17]
set_property port_width 1 [get_debug_ports usb_core_ila/probe17]
connect_debug_port usb_core_ila/probe17 [get_nets [list u_system/caliptra_htg940_bd_i/caliptra_package_top_0/inst/cptra_wrapper/htg_ulpi_clock_activity]]
set_property C_CLK_INPUT_FREQ_HZ 300000000 [get_debug_cores dbg_hub]
set_property C_ENABLE_CLK_DIVIDER false [get_debug_cores dbg_hub]
set_property C_USER_SCAN_CHAIN 1 [get_debug_cores dbg_hub]
connect_debug_port dbg_hub/clk [get_nets cptra_ss_usb_ulpi_clk_i_IBUF]
