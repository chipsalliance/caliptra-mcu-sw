[submodule "hw/caliptra-ss"]
	path = hw/rev-2_1/caliptra-ss
	url = https://github.com/chipsalliance/caliptra-ss
	branch = main
[submodule "network/net/lwip"]
	path = network/net/lwip
	url = https://github.com/chipsalliance/caliptra-lwip.git
	branch = caliptra-main
[submodule "hw/latest/caliptra-ss"]
	path = hw/latest/caliptra-ss
	url = https://github.com/chipsalliance/caliptra-ss
[submodule "core/caliptra-sw"]
	path = core/caliptra-sw
	# TEMPORARY: the pins in core/versions.toml carry the SocManager changes from
	# the leongross/caliptra-sw fork. Restore chipsalliance/caliptra-sw once merged.
	url = https://github.com/leongross/caliptra-sw
	branch = caliptra-2.2-dev
